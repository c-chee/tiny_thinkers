
 <section class="contact">
        <div class="content">
                <h2>Contact and Support</h2>
                <p>We're here to help. Reach out with questions, concerns, or support needs.</p>
        </div>
        <div class="container">
            <div class="contactInfo">
                <div class="box">
                    <div class="icon"><i class="fa fa-map-marker" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Address</h3>
                        <p>26 Pacific Park<br>Santa Monica, CA<br>90401</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-phone" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Phone</h3>
                        <p>+1 9837424750</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Email</h3>
                        <p>volunteer@tinythinkers.org</p>
                    </div>
                </div>
            </div>
            <div class="contactForm">
                <form id="volunteerForm">
                    <div class="heading">
                         <h2>Get in Touch</h2>
                        <p>Send us a message and our team will get back to you shortly</p>
                    </div>
                    <div class="inputBox">
                        <input type="text" name="" id="firstName" required="required">
                        <span>Your First Name</span>
                    </div>
                    <div class="inputBox">
                        <input type="text" name="" required="required">
                        <span>Your Last Name</span>
                    </div>
                    <div class="inputBox">
                        <input type="email" name="" required="required">
                        <span>Your Email</span>
                    </div>
                    <div class="inputBox">
                        <input type="tel" name="" required="required">
                        <span>Your Phone Number</span>
                    </div>
                    <div class="inputBox">
                        <select name="contactMethod" required>
                            <option value="" disabled selected></option>
                            <option value="email">Email</option>
                            <option value="phone">Phone</option>
                            <option value="text">Text</option>
                        </select>
                        <span>How should we reach you?</span>
                    </div>
                    <div class="inputBox">
                        <select name="contactReason" required>
                            <option value="" disabled selected></option>
                            <option value="general">General</option>
                            <option value="support">Support Request</option>
                            <option value="technical">Technical Issue</option>
                            <option value="partnership">Partnerships</option>
                            <option value="feedback">Feedback</option>
                        </select>
                        <span>Reason for Contact</span>
                    </div>
                    <div class="inputBox">
                        <textarea required></textarea>
                        <span>Your Message</span>
                    </div>
                    <div class="inputBox">
                        <input type="submit" name="" value="Send Message">
                    </div>     
                </form>
            </div>
            <div class="thankYouMessage"></div>
            <div class="confetti"></div>

        </div>            
            
        <div id="sparkle">
            <img  class="images" src="./images/sparkle.png" alt="Picture of Sparkle">
        </div>
        <div id="SparkleTwo">
            <img class="images" src="./images/star2.PNG" alt="Picture of Sparkle Two">
        </div>
         <div id="pencil">
            <img class="images" src="./images/pencil.png" alt="Picture of Pencil">
        </div>

        <!-- back to dashboard -->
        <section class="cards-back">
            <div class="container">
            <div class="back-row">
                <a href="/dashboard" class="back-btn">Back to Dashboard</a>
            </div>
            </div>
        </section>

 </section>
