<body>
    <section class="contact">
        <div class="content">
                <h2>Help Shape Brighter Futures</h2>
            <p>Volunteer your time to support children, learning, and growth.</p>
        </div>
        <div class="container">
            <div class="contactInfo">
                <div class="box">
                    <div class="icon"><i class="fa fa-map-marker" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Address</h3>
                        <p>26 Pacific Park<br>Santa Monica, CA<br>90401</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-phone" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Phone</h3>
                        <p>+1 9837424750</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Email</h3>
                        <p>volunteer@tinythinkers.org</p>
                    </div>
                </div>
            </div>
            <div class="contactForm">
                <form>
                    <h2>Sign Up</h2>
                    <div class="inputBox">
                        <input type="text" name="" required="required">
                        <span>First Name</span>
                    </div>
                    <div class="inputBox">
                        <input type="text" name="" required="required">
                        <span>Last Name</span>
                    </div>
                    <div class="inputBox">
                        <input type="email" name="" required="required">
                        <span>Email</span>
                    </div>
                    <div class="inputBox">
                        <input type="tel" name="" required="required">
                        <span>Phone Number</span>
                    </div>
                    <div class="inputBox">
                        <select name="contactMethod" required>
                            <option value="" disabled selected></option>
                            <option value="email">Email</option>
                            <option value="phone">Phone</option>
                            <option value="text">Text</option>
                        </select>
                        <span>Preffered Method of Contact</span>
                    </div>
                    <div class="inputBox">
                        <input type="submit" name="" required="Sign Me Up!">
                    </div>
                </form>
            </div>
        </div>
    </section>
</body>