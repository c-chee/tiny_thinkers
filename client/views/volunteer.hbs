
 <section class="contact">
        <div class="content">
                <h2>Help Shape Brighter Futures</h2>
                <p>Volunteer your time to support children, learning, and growth.</p>
        </div>
        <div class="container">
            <div class="contactInfo">
                <div class="box">
                    <div class="icon"><i class="fa fa-map-marker" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Address</h3>
                        <p>26 Pacific Park<br>Santa Monica, CA<br>90401</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-phone" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Phone</h3>
                        <p>+1 9837424750</p>
                    </div>
                </div>
                <div class="box">
                    <div class="icon"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                    <div class="text">
                        <h3>Email</h3>
                        <p>volunteer@tinythinkers.org</p>
                    </div>
                </div>
            </div>
            <div class="contactForm">
                <form id="volunteerForm">
                    <div class="heading">
                         <h2>Volunteer With Heart</h2>
                        <p>Your time, care, and kindness can make a real difference.</p>
                    </div>
                    <div class="inputBox">
                        <input type="text" name="" id="firstName" required="required">
                        <span>Your First Name</span>
                    </div>
                    <div class="inputBox">
                        <input type="text" name="" required="required">
                        <span>Your Last Name</span>
                    </div>
                    <div class="inputBox">
                        <input type="email" name="" required="required">
                        <span>Your Email</span>
                    </div>
                    <div class="inputBox">
                        <input type="tel" name="" required="required">
                        <span>Your Phone Number</span>
                    </div>
                    <div class="inputBox">
                        <select name="contactMethod" required>
                            <option value="" disabled selected></option>
                            <option value="email">Email</option>
                            <option value="phone">Phone</option>
                            <option value="text">Text</option>
                        </select>
                        <span>How should we reach you?</span>
                    </div>
                    <div class="inputBox">
                        <select name="volunteerType" required>
                            <option value="" disabled selected></option>
                            <option value="event">Event Support</option>
                            <option value="tutoring">Tutoring/Mentoring</option>
                            <option value="admin">Administrative Help</option>
                            <option value="outreach">Outreach/Community Engagement</option>
                            <option value="virtual">Virtual/Remote Support</option>
                        </select>
                        <span>How would you like to help?</span>
                    </div>
                    <div class="checkBox">
                        <label>
                            <input type="checkbox" required>
                            <span>
                                I understand this role supports children and may require additional screening or training.
                            </span>
                        </label>
                    </div>  
                    <div class="inputBox">
                        <input type="submit" name="" value="Sign Me Up!">
                    </div>     
                </form>
            </div>
            <div class="thankYouMessage"></div>
            <div class="confetti"></div>

        </div>            
            
        <div id="sparkle">
            <img  class="images" src="./images/sparkle.png" alt="Picture of Sparkle">
        </div>
        <div id="SparkleTwo">
            <img class="images" src="./images/star2.PNG" alt="Picture of Sparkle Two">
        </div>
         <div id="pencil">
            <img class="images" src="./images/pencil.png" alt="Picture of Pencil">
        </div>

 </section>
