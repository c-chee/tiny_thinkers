<main class="reading-page">

  <!-- hero with back to top anchor -->
  <section class="hero-band reading-hero" id="top">
    <div class="squiggle squiggle-hero-right"></div>
    <div class="container hero-grid">
      <div class="hero-left">
        <h1 class="title">Reading Comprehension</h1>
        <p class="subtitle">
          Build strong reading skills with age-appropriate books and guided questions. 
          Help your child discover the joy of reading through interactive activities and personalized support.
        </p>
        
        <!-- grade selector -->
        <div class="grade-selector">
          <form method="GET" action="/reading" class="selector-form">
            <label for="grade">Select Grade Level</label>
            <select name="grade" id="grade" onchange="this.form.submit()">
              <option value="kindergarten" {{isSelected grade "kindergarten"}}>Kindergarten</option>
              <option value="first" {{isSelected grade "first"}}>1st Grade</option>
              <option value="second" {{isSelected grade "second"}}>2nd Grade</option>
              <option value="third" {{isSelected grade "third"}}>3rd Grade</option>
              <option value="fourth" {{isSelected grade "fourth"}}>4th Grade</option>
              <option value="fifth" {{isSelected grade "fifth"}}>5th Grade</option>
            </select>
          </form>
        </div>
      </div>

      <div class="hero-right">
        <!-- tiny reading scene -->
        
      </div>
    </div>
    <div class="wave wave-hero"></div>
  </section>

  <!-- tips section -->
  <section class="band band-tips white-band">
    <div class="squiggle squiggle-meet-left"></div>
    <div class="container">
      <div class="tips-content">
        <div class="tips-text">
          <p class="label">Reading Tips</p>
          <h2 class="h2 pop-title">How to Make Reading Fun</h2>
          <ul class="tips-list">
            {{#each data.tips}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
        <div class="tips-image">
          
        </div>
      </div>
    </div>
    <div class="wave wave-tips-bottom"></div>
  </section>

  <!-- books section -->
  <section class="band band-books">
    <div class="squiggle squiggle-mint-right"></div>
    <div class="container">
      <p class="label label-orange">Recommended Books</p>
      <h2 class="h2 pop-title">Books for {{grade}} Grade</h2>
      <p class="body">Click any book cover to read a free digital copy</p>
      
      <ul class="books-grid">
        {{#each data.books}}
        <li class="book-item">
          <a href="{{link}}" target="_blank" rel="noopener noreferrer">
            <img src="{{image}}" alt="{{title}}" class="book-cover"/>
            <h3 class="book-title">{{title}}</h3>
            <p class="book-author">By {{author}}</p>
          </a>
        </li>
        {{/each}}
      </ul>
    </div>
    <div class="wave wave-books-bottom"></div>
  </section>

  <!-- questions section -->
  <section class="band band-questions white-band">
    <div class="squiggle squiggle-lav-left"></div>
    <div class="container">
      <p class="label label-purple">Discussion Questions</p>
      <h2 class="h2 pop-title">Great Questions to Ask</h2>
      <p class="body">Use these questions to help your child think deeper about what they're reading</p>
      
      <ul class="questions-list">
        {{#each data.questions}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
    <div class="wave wave-questions-bottom"></div>
  </section>

  <!-- reading tracker section -->
  <section class="band band-tracker">
    <div class="container">
      <p class="label label-mint">Daily Tracker</p>
      <h2 class="h2 pop-title">Reading Minutes This Week</h2>
      <p class="body">Track your child's daily reading time and watch their progress grow</p>
      
      <div class="tracker-card">
        <div class="day-tracker">
          <div class="day">
            <label for="monday">Monday</label>
            <input type="number" id="monday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>

          <div class="day">
            <label for="tuesday">Tuesday</label>
            <input type="number" id="tuesday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>

          <div class="day">
            <label for="wednesday">Wednesday</label>
            <input type="number" id="wednesday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>

          <div class="day">
            <label for="thursday">Thursday</label>
            <input type="number" id="thursday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>

          <div class="day">
            <label for="friday">Friday</label>
            <input type="number" id="friday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>

          <div class="day">
            <label for="saturday">Saturday</label>
            <input type="number" id="saturday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>

          <div class="day">
            <label for="sunday">Sunday</label>
            <input type="number id="sunday" min="0" placeholder="0" class="minutes-input" oninput="calculateTotal()"/>
          </div>
        </div>

        <div class="total-display">
          <strong>Total:</strong> <span id="totalMinutes">0</span> minutes this week
        </div>
      </div>
    </div>
  </section>

  <!-- back to dashboard and back to top -->
  <section class="back-section">
    <div class="container">
      <div class="back-row">
        <a href="/dashboard" class="btn-pill btn-solid back-btn">Back to Dashboard</a>
      </div>
    </div>
  </section>

  <!-- back to top button -->
  <div class="back-to-top-wrap">
    <button type="button" class="btn-pill btn-solid back-to-top-btn" id="backToTopBtn">
      Back to top ▲
    </button>
  </div>

</main>

<script>
function calculateTotal() {
  const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
  let total = 0;
  
  days.forEach(day => {
    const input = document.getElementById(day);
    const value = parseInt(input.value) || 0;
    total += value;
  });
  
  document.getElementById('totalMinutes').textContent = total;
}

// Back to top button functionality
const backToTopBtn = document.getElementById('backToTopBtn');

window.addEventListener('scroll', () => {
  if (window.scrollY > 300) {
    backToTopBtn.classList.add('visible');
  } else {
    backToTopBtn.classList.remove('visible');
  }
});

backToTopBtn.addEventListener('click', () => {
  window.scrollTo({ top: 0, behavior: 'smooth' });
});
</script>
