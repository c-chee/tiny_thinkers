<body>

  <main>
    <!-- hero -->
    <section class="hero-band">
      <div class="squiggle squiggle-hero-right"></div>
      <div class="container hero-grid">
        <div class="hero-left">
          <h1 class="title">Tiny Thinkers</h1>
          <p class="subtitle">
            Free, accessible learning support for Charlotte-Mecklenburg
            elementary students— building strong literacy and math foundations
            no matter a child's zip code.
          </p>

          <!-- sign up / login -->
          <div class="btn-row">
            <a class="btn-pill btn-solid" href="/login?mode=register">Sign up</a>
            <a class="btn-pill btn-ghost" href="/login?mode=login">Log in</a>
          </div>
        </div>

        <div class="hero-right">
          <!-- tiny img -->
          <div
            class="tiny-scene hero-scene"
            id="heroTinyScene"
            aria-label="Tiny animation scene"
          >
            <img
              class="tiny-base"
              src="/images/tiny_base.PNG"
              alt="Tiny reading a book"
            />

            <img class="float pencil" src="/images/pencil.PNG" alt="" />
            <img class="float heart" src="/images/heart.PNG" alt="" />
            <img class="float sparkle" src="/images/sparkle.PNG" alt="" />
            <img class="float block" src="/images/block.PNG" alt="" />
          </div>
        </div>
      </div>
      <div class="wave wave-hero"></div>
    </section>

    <!-- meet tiny section -->
    <section class="white-band">
      <div class="squiggle squiggle-meet-left"></div>

      <div class="container meet-grid">
        <div class="meet-left">
          <img
            class="tiny-meet rock"
            src="/images/tiny1.PNG"
            alt="Tiny the mascot"
          />
        </div>

        <div class="meet-right">
          <p class="label">Meet our mascot</p>
          <h2 class="h2 pop-title">Meet Tiny!</h2>

          <p class="body">
            Tiny is here to make reading, spelling, vocabulary, letter
            recognition, and number practice feel friendly and fun!
          </p>

          <div class="speech">
            <p>
              <strong>Tiny says:</strong>
              "You've got this! Let's learn together."
            </p>
          </div>
        </div>
      </div>

      <div class="wave wave-white"></div>
    </section>

    <!-- what we do section -->
    <section class="band band-mint">
      <div class="squiggle squiggle-mint-right"></div>

      <div class="container section-grid">
        <div class="section-left">
          <h2 class="h2 pop-title">What we do</h2>
          <p class="body">
            We believe every child deserves a strong educational foundation,
            regardless of their zip code or family income. Tiny Thinkers reduces
            educational inequity in Charlotte-Mecklenburg by providing
            completely free literacy and math support designed for elementary
            students K-5. With kid-friendly practice tools, tutoring-style
            guidance, and research-based learning activities, we're helping
            bridge opportunity gaps and build confidence in young learners
            across our community.
          </p>
        </div>

        <div class="section-right features">
          <div class="feature">
            <h3>Spelling & Vocab</h3>
            <p>Word practice designed for early learners.</p>
          </div>
          <div class="feature">
            <h3>Letter Recognition</h3>
            <p>Build reading confidence step-by-step.</p>
          </div>
          <div class="feature">
            <h3>Number Skills</h3>
            <p>Counting, basics, and foundations.</p>
          </div>
          <div class="feature">
            <h3>Accessible Learning</h3>
            <p>No cost barriers, just opportunities to grow.</p>
          </div>
        </div>

        <!-- apple -->
        <div class="apple-wrapper">
          <img
            src="/images/applee.PNG"
            alt="Apple doodle"
            class="apple-doodle"
          />
        </div>
      </div>
      <div class="wave wave-mint-bottom"></div>
    </section>

    <!-- statistics / by the numbers section -->
    <section class="white-band band-stats">
      <div class="container stats-grid">
        <div class="stats-left">
          <p class="label label-yellow">By the Numbers</p>

          <!-- orange squiggle UNDER subtitle -->
          <div class="squiggle squiggle-orange-left"></div>

          <h2 class="h2 pop-title">Tiny Thinkers by the Numbers</h2>
          <p class="body">
            A quick look at why free, supportive practice tools matter for our
            community.
          </p>
        </div>

        <div class="stats-right">
          <div class="stats-container">
            <div class="stats-slideshow">
              <div class="stats-track">
                <div class="stat-slide">
                  <div class="speech">
                    <p><strong>30%</strong>
                      of CMS students read below grade level</p>
                  </div>
                </div>

                <div class="stat-slide">
                  <div class="speech">
                    <p><strong>25%</strong>
                      of CMS students perform below grade level in math</p>
                  </div>
                </div>

                <div class="stat-slide">
                  <div class="speech">
                    <p><strong>60%+</strong>
                      of CMS students qualify for free/reduced lunch</p>
                  </div>
                </div>

                <div class="stat-slide">
                  <div class="speech">
                    <p><strong>147K+</strong>
                      students in Charlotte-Mecklenburg Schools</p>
                  </div>
                </div>

                <div class="stat-slide">
                  <div class="speech">
                    <p><strong>100%</strong>
                      free for every family, every child</p>
                  </div>
                </div>

                <div class="stat-slide">
                  <div class="speech">
                    <p><strong>K-5</strong> elementary students supported</p>
                  </div>
                </div>
              </div>

              <div class="slideshow-dots" id="statsDots"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="wave wave-yellow-bottom"></div>
    </section>

    <!-- how it works section -->
    <section class="band band-lavender">
      <div class="squiggle squiggle-lav-left"></div>
      <div class="container how-grid">
        <div class="how-left">
          <h2 class="h2 pop-title">How it works</h2>
          <p class="body">
            Every child learns differently, and Tiny Thinkers is built to
            support those differences. Children can choose what they want to
            practice and move through activities in a way that feels comfortable
            for them. With friendly feedback and easy-to-follow steps, kids can
            learn from their mistakes and feel proud of their progress. Tiny
            Thinkers is not about perfection, it's about helping children feel
            capable, confident, and excited to learn more.
          </p>

          <!-- 1 , 2, 3 steps -->
          <div class="steps">
            <div class="step"><span>1</span> Choose a skill</div>
            <div class="step"><span>2</span> Practice with Tiny</div>
            <div class="step"><span>3</span> Grow with confidence</div>
          </div>
        </div>

        <div class="how-right">
          <h3 class="h3">Ready to start?</h3>
          <p class="body small">
            Try a quick activity and meet Tiny inside the app.
          </p>
          <!-- start learning / sign up button -->
          <a class="btn-pill btn-solid" href="/signup">Start learning</a>
          <div class="start-tiny" id="startTinyScene">
            <div class="tiny-scene start-scene">
              <img
                class="tiny-base"
                src="/images/tinybase2.PNG"
                alt="Tiny ready to learn"
              />

              <img class="float star star-1" src="/images/star1.PNG" alt="" />
              <img class="float star star-2" src="/images/star2.PNG" alt="" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- script link -->
  <script src="Home.js"></script>
</body>