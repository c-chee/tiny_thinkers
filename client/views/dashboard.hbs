<main class="dashboard">
  <div class="dash-wrap">
    <div class="dash-head">
      <h1 class="dash-title">Dashboard</h1>
      <p class="dash-sub">Pick an activity to get started.</p>
    </div>

    <section class="bento" aria-label="dashboard options">
      {{#each tiles}}
        <a class="tile {{class}}" href="{{route}}">
          <div class="tile-inner">
            <h2 class="tile-title">{{label}}</h2>
            <p class="tile-text">{{description}}</p>
            <span class="tile-cta">Open</span>
          </div>
        </a>
      {{/each}}
    </section>

  </div>
</main>