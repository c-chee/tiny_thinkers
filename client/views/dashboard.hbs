<main class="dashboard">

    <h1>Dashboard</h1>

    <a href = "/settings" class = "settings-btn">Settings</a>

    <div class="bento-grid">

        {{#each contentTypes}}
        <div class="bento-card">
            <h3>{{this}}</h3>

            <a href="/content/{{this}}">Open</a>

        </div>
        {{/each}}

    </div>

</main>

